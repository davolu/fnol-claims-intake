# Copy to .env and fill in. Never commit .env.
# --- core ---
DATABASE_URL=postgresql://fnol:fnol@localhost:5432/fnol   # omit to use SQLite at ./data/fnol.db
APP_API_TOKEN=                 # long random string; the web server sends it to the API
FNOL_SECRETS_KEY=              # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STORAGE_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000
# --- model ---
LLM_PROVIDER=anthropic         # anthropic | openai | azure_openai
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# --- OCR ---
OCR_ENGINE=tesseract           # tesseract | azure_di
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# --- decisions (defaults; editable later in Settings > AI & rules) ---
CONFIDENCE_THRESHOLD=0.85
AUTO_PUSH=true
MAX_AGENT_STEPS=6
# --- email intake ---
COMPOSIO_API_KEY=              # only for the Composio Gmail connector
SEED_COMPOSIO_USER_ID=         # optional: pre-create an (inactive) Composio Gmail connector for this user id
SEED_COMPOSIO_QUERY=subject:FNOL newer_than:30d
EMAIL_POLL_SECONDS=120
WORKER_POLL_SECONDS=2
# --- demo stand-in (remove in production) ---
MOCK_CLAIMCENTER_URL=http://localhost:8090
MOCK_CLAIMCENTER_CLIENT_SECRET=stand-in-secret
